# `make dev-up` copies this file to .env (git-ignored) if it is missing, and docker
# compose reads .env automatically. The stack is validated with oCIS 9.0.0-rc.1, the release the
# extension is built against (@ownclouders/* 12.5.0).
OCIS_DOCKER_TAG=9.0.0-rc.1

# Port of the https proxy, the same outside and inside the containers (nginx listens on it
# and oCIS shares its network namespace); OCIS_URL, the browser URL and AGENT_OCIS_URL all
# use it. Changing it after the first start needs `docker compose down -v` (oCIS stores
# the URL in its volumes).
# Because oCIS shares nginx's network namespace, this port must not collide with any port
# oCIS binds internally (19200 for its proxy, the 9100-9300 service ports, e.g. 9142, 9233);
# the default 9200 is fine because oCIS' own proxy is moved to 19200.
OCIS_DEV_PORT=9200

# Host port of the sidecar (`make sidecar` listens on it, nginx forwards /agent-api/ to it).
# Change it when 9300 is taken; recreate the proxy with `docker compose up -d` afterwards.
AGENT_DEV_PORT=9300

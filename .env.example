# `make dev-up` copies this file to .env (git-ignored) if it is missing, and docker
# compose reads .env automatically. Pin this to the released oCIS tag you validate against
# (the dev stack targets oCIS v9.0.0-rc.1 sources; confirm the published image tag).
OCIS_DOCKER_TAG=latest

# Host port of the https proxy; OCIS_URL, the browser URL and AGENT_OCIS_URL all use it.
OCIS_DEV_PORT=9200

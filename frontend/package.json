{
  "name": "web-app-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "oCIS Web extension for the always-on personal agent",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {

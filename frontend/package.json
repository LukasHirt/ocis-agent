    "@ownclouders/web-pkg": "12.5.0",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "20.8.9",
    "pinia": "^3.0.4",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-router": "^5.0.6",
    "vue-tsc": "3.3.13",
    "vue3-gettext": "^2.4.0"
  }
}

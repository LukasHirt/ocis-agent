# Rendered by the nginx image's envsubst template mechanism (only ${OCIS_DEV_PORT} and
# ${AGENT_DEV_PORT} are substituted). nginx listens on the same port inside and outside, and the ocis container
# shares this network namespace, so https://localhost:${OCIS_DEV_PORT} also works from
# inside oCIS (OIDC discovery, the ocdav data gateway).
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen ${OCIS_DEV_PORT} ssl;
  ssl_certificate     /etc/nginx/certs/localhost.crt;
  ssl_certificate_key /etc/nginx/certs/localhost.key;

  client_max_body_size 0;
  proxy_buffering off;
  proxy_http_version 1.1;
  proxy_read_timeout 1h;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-For $remote_addr;

  location /agent-api/ {
    proxy_pass http://host.docker.internal:${AGENT_DEV_PORT};
  }

  location / {
    # oCIS' own proxy binds 127.0.0.1:19200 (PROXY_HTTP_ADDR) in the shared namespace
    proxy_pass http://127.0.0.1:19200;
    # repeated: proxy_set_header in a location replaces the server-level ones
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}
